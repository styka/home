datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── 054 (zadanie 11, etap 1 z czterech): kolumna `workspaceId` ───────────
//
// Własność zasobu ma docelowo przestać być parą `ownerId`/`ownerTeamId`, a stać się jednym
// `workspaceId` (rozdz. 8.2 i 8.10 „architektury docelowej"). Rozbicie na cztery etapy jest
// wymogiem, nie ostrożnością: (1) kolumna NULLABLE + backfill ← ZROBIONE, migracja 0227,
// (2) utrzymywanie jej dla nowych rekordów, (3) przełączenie odczytów, (4) `NOT NULL`.
//
// DZIŚ KOLUMNA NIE MA ANI JEDNEGO CZYTELNIKA — dostęp i własność liczą się dalej przez
// `ownerId`/`ownerTeamId`. Nie pisz zapytań po `workspaceId`, dopóki nie wejdzie etap 3;
// rekord utworzony po migracji 0227 ma tam NULL, bo etap 2 jeszcze nie istnieje.
//
// Kolumnę ma model z `ownerId` lub `ownerTeamId` (45 modeli). Poza zbiorem świadomie:
// `Task` (własność przez `createdById`/projekt) i `Team` (źródło przestrzeni, nie zasób w niej).

// ─── NextAuth required models ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  avatarUrl     String?
  role          String    @default("USER") // "USER" | "ADMIN"
  icalToken     String?   @unique // Z-150: odwoływalny token feedu iCal (subskrypcja agendy)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  accounts                Account[]
  sessions                Session[]
  driveConnection         DriveConnection?       @relation("UserDriveConnection")
  driveFiles              DriveFile[]            @relation("UserDriveFiles")
  ownedTeams              Team[]                 @relation("TeamOwner")
  teamMemberships         TeamMember[]
  sentInvitations         TeamInvitation[]       @relation("InvitedBy")
  receivedInvitations     TeamInvitation[]       @relation("InvitedUser")
  ownedLists              ShoppingList[]
  products                Product[]
  units                   Unit[]
  categories              Category[]
  ownedTaskProjects       TaskProject[]          @relation("OwnedTaskProjects")
  taskProjectMemberships  TaskProjectMember[]    @relation("TaskProjectMemberships")
  tasksCreated            Task[]                 @relation("TasksCreatedBy")
  tasksAssigned           Task[]                 @relation("TasksAssignedTo")
  taskComments            TaskComment[]          @relation("TaskComments")
  taskShares              TaskShare[]            @relation("TaskShares")
  activities              UserActivity[]
  stores                  Store[]
  categoryIconVariants    CategoryIconVariant[]
  userRoles               UserRole[]
  ownedNotes              Note[]                 @relation("OwnedNotes")
  ownedNoteGroups         NoteGroup[]            @relation("OwnedNoteGroups")
  ownedTags               Tag[]                  @relation("OwnedTags")
  ownedItemHistory        ItemHistory[]          @relation("OwnedItemHistory")
  llmPrefs                UserLlmPref[]          @relation("UserLlmPrefs")
  reports                 Report[]               @relation("AuthoredReports")
  aiConversations         AiConversation[]       @relation("AiConversations")
  qaScenarios             QaTestScenario[]       @relation("QaAuthored")
  recipes                 Recipe[]               @relation("OwnedRecipes")
  cookbooks               Cookbook[]             @relation("OwnedCookbooks")
  mealPlans               MealPlanEntry[]        @relation("OwnedMealPlans")
  pantryItems             PantryItem[]           @relation("OwnedPantryItems")
  storageItems            StorageItem[]          @relation("OwnedStorageItems")
  storageSuppliers        StorageSupplier[]      @relation("OwnedStorageSuppliers")
  storageDocuments        StorageDocument[]      @relation("OwnedStorageDocuments")
  storageOrders           StoragePurchaseOrder[] @relation("OwnedStorageOrders")
  storageSettings         StorageSettings?
  recipeRatings           RecipeRating[]
  vehicleProfile          VehicleProfile?
  ownedPets               Pet[]                  @relation("OwnedPets")
  petShares               PetShare[]             @relation("PetShares")
  ownedEnclosures         PetEnclosure[]         @relation("OwnedEnclosures")
  ownedBreedingPairs      PetBreedingPair[]      @relation("OwnedPairs")
  petSales                PetSale[]              @relation("OwnedPetSales")
  vehicles                Vehicle[]              @relation("OwnedVehicles")
  walletElements          WalletElement[]        @relation("OwnedWalletElements")
  budgets                 Budget[]               @relation("OwnedBudgets")
  financeGoals            FinanceGoal[]          @relation("OwnedFinanceGoals")
  financeSettings         FinanceSettings?       @relation("UserFinanceSettings")
  exchangeRates           ExchangeRate[]         @relation("UserExchangeRates")
  trashItems              TrashItem[]            @relation("UserTrashItems")
  dashboardPref           DashboardPref?         @relation("UserDashboardPref")
  favoriteViews           FavoriteView[]         @relation("OwnedFavoriteViews")
  assistantPref           AssistantPref?         @relation("UserAssistantPref")
  languageDecks           LanguageDeck[]         @relation("OwnedLanguageDecks")
  healthEvents            HealthEvent[]          @relation("OwnedHealthEvents")
  medicationSchedules     MedicationSchedule[]   @relation("OwnedMedicationSchedules")
  habits                  Habit[]                @relation("OwnedHabits")
  serviceProvider         ServiceProvider?       @relation("UserServiceProvider")
  serviceCategories       ServiceCategory[]      @relation("OwnedServiceCategories")
  serviceRequestsAsClient ServiceRequest[]       @relation("ClientServiceRequests")
  serviceReviews          ServiceReview[]        @relation("AuthoredServiceReviews")
  menuPref                UserMenuPref?
  newsSources             NewsSource[]           @relation("OwnedNewsSources")
  newsTopics              NewsTopic[]            @relation("OwnedNewsTopics")
  newsPref                NewsPref?              @relation("NewsPref")
  newsArticles            NewsArticle[]          @relation("OwnedNewsArticles")
  newsHiddenTopics        NewsHiddenTopic[]      @relation("OwnedNewsHiddenTopics")
  userFacts               UserFact[]             @relation("OwnedUserFacts")
  weatherLocations        WeatherLocation[]      @relation("OwnedWeatherLocations")
  weatherWatchers         WeatherWatcher[]       @relation("OwnedWeatherWatchers")
  weatherIdeas            WeatherIdea[]          @relation("OwnedWeatherIdeas")
  aiContents              AiContent[]            @relation("OwnedAiContent")
  aiSectionPrefs          AiSectionPref[]        @relation("OwnedAiSectionPrefs")
  newsRefreshRuns         NewsRefreshRun[]       @relation("OwnedNewsRefreshRuns")
  projectGroups           ProjectGroup[]         @relation("OwnedProjectGroups")
  skins                   Skin[]                 @relation("SkinOwner")
  skinPref                UserSkinPref?
  warsztatSettings        WarsztatSettings?
  ownedWorkshops          Workshop[]             @relation("OwnedWorkshops")
  notifications           Notification[]         @relation("UserNotifications")
  serviceMessages         ServiceMessage[]       @relation("SentServiceMessages")
  consents                UserConsent[]          @relation("UserConsents")
  aiUsage                 AiUsage[]              @relation("UserAiUsage")
  healthSettings          HealthSettings?        @relation("UserHealthSettings")
  subscription            Subscription?          @relation("UserSubscription")
  personalWorkspace       Workspace?             @relation("PersonalWorkspace")
  workspaceMemberships    WorkspaceMember[]
}

// Z-471 (monetyzacja): plan handlowy użytkownika. Definicje planów (limity/funkcje)
// żyją w kodzie (`src/lib/plans.ts`) — rzadko się zmieniają; tabela trzyma tylko
// przypisanie + status. Brak wiersza = plan `free`. Bramka płatności (Z-473) ustawi
// `planKey`/`status`/`currentPeriodEnd` przez webhooki (gdy właściciel wybierze dostawcę).
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  planKey          String    @default("free") // "free" | "premium"
  status           String    @default("active") // "active" | "canceled" | "past_due"
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation("UserSubscription", fields: [userId], references: [id], onDelete: Cascade)
}

// Z-270 (ochrona danych zdrowotnych): per-user ustawienia modułu Zdrowie.
// `aiOptIn` DOMYŚLNIE false — asystent AI NIE widzi danych zdrowotnych, dopóki
// użytkownik świadomie nie włączy (privacy-by-default dla danych wrażliwych).
model HealthSettings {
  userId    String   @id
  aiOptIn   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation("UserHealthSettings", fields: [userId], references: [id], onDelete: Cascade)
}

// Z-053 (RODO): zgody użytkownika na dokumenty prawne (polityka prywatności,
// regulamin). Wersjonowane — wpisujemy zaakceptowaną wersję; ponowna akceptacja
// nadpisuje. Brak akceptacji bieżącej wersji → baner zgód.
model UserConsent {
  id          String   @id @default(cuid())
  userId      String
  documentKey String // "privacy" | "terms" (klucz dokumentu z lib/legal/documents)
  version     String // wersja zaakceptowanego dokumentu
  acceptedAt  DateTime @default(now())
  user        User     @relation("UserConsents", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentKey])
  @@index([userId])
}

// Z-130/Z-511 (kontrola kosztów AI): trwałe, dzienne zużycie AI per użytkownik —
// liczba zapytań i przybliżone tokeny. Działa między instancjami (wspólna baza),
// w przeciwieństwie do liczników in-memory. Budżet zależny od planu (lib/ai/usage).
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD (UTC) — okno dzienne
  requests  Int      @default(0)
  tokens    Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation("UserAiUsage", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

// Preferencje paska bocznego/menu per użytkownik: kolejność i wyłączone moduły.
model UserMenuPref {
  userId    String   @id
  order     String   @default("[]") // JSON: string[] id modułów w kolejności użytkownika
  disabled  String   @default("[]") // JSON: string[] id modułów wyłączonych przez użytkownika
  tabBar    String   @default("[]") // JSON: string[] id modułów w dolnym pasku (mobile), w kolejności użytkownika
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Skórka (motyw): częściowa mapa zmiennych CSS aplikowana inline na <html>.
// Skórki systemowe (isSystem=true, ownerId/ownerTeamId=null) zarządza admin.
// Skórki użytkownika/zespołu mają ownera; isPublic ⇒ widoczna i reużywalna przez wszystkich.
model Skin {
  id          String   @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean  @default(false)
  colorScheme String   @default("dark") // "dark" | "light" — schemat natywnych kontrolek
  tokens      String   @default("{}") // JSON: { "--bg-base":"#..", "--radius":"8px", ... }
  ownerId     String?
  ownerTeamId String?
  isPublic    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User? @relation("SkinOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team? @relation("SkinTeam", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// Wybrana przez użytkownika skórka (null ⇒ domyślna ciemna).
model UserSkinPref {
  userId    String   @id
  skinId    String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   String // "USER" | "ADMIN" | "BETA_TESTER"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  role         String
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ── Google Drive integration (per-user file store via OAuth drive.file scope) ──
// User connects their own Google Drive in Settings; we only ever see/manage files
// the app itself creates (drive.file scope). Tokens are stored per-user so the
// server can upload/stream on their behalf.
model DriveConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  email                String? // the Google account the Drive belongs to
  refreshToken         String? // long-lived; obtained with access_type=offline
  accessToken          String?
  accessTokenExpiresAt DateTime?
  rootFolderId         String? // id of the "Omnia" root folder on the user's Drive
  folderMap            String    @default("{}") // JSON: { [module]: folderId }
  connectedAt          DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation("UserDriveConnection", fields: [userId], references: [id], onDelete: Cascade)
}

// Registry of files the app uploaded to a user's Drive. Lets the proxy resolve
// the owner/mime to stream a file, and gives a handle for management/deletion.
model DriveFile {
  id           String   @id @default(cuid())
  userId       String
  driveFileId  String   @unique
  module       String // which module the file belongs to (string, no enums on SQLite)
  originalName String
  mimeType     String
  size         Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation("UserDriveFiles", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Teams ────────────────────────────────────────────────────────────────

/// 054: BEZ `workspaceId` — zespół jest ŹRÓDŁEM przestrzeni (`Workspace.teamId`), a nie
/// zasobem, który w jakiejś przestrzeni żyje. Dołożenie tu kolumny tworzyłoby pętlę pojęciową.
model Team {
  id           String   @id @default(cuid())
  name         String
  description  String?
  avatarUrl    String?
  kind         String   @default("team") // "team" | "household" (Z-192 preset rodziny)
  ownerId      String
  parentTeamId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  owner                User                   @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  parentTeam           Team?                  @relation("SubTeams", fields: [parentTeamId], references: [id], onDelete: SetNull)
  subTeams             Team[]                 @relation("SubTeams")
  members              TeamMember[]
  invitations          TeamInvitation[]
  lists                ShoppingList[]         @relation("TeamLists")
  products             Product[]
  units                Unit[]
  categories           Category[]
  taskProjects         TaskProject[]          @relation("TeamTaskProjects")
  taskShares           TaskShare[]            @relation("TeamTaskShares")
  notes                Note[]                 @relation("TeamNotes")
  noteGroups           NoteGroup[]            @relation("TeamNoteGroups")
  tags                 Tag[]                  @relation("TeamTags")
  categoryIconVariants CategoryIconVariant[]  @relation("TeamIconVariants")
  reports              Report[]               @relation("TeamReports")
  recipes              Recipe[]               @relation("TeamRecipes")
  cookbooks            Cookbook[]             @relation("TeamCookbooks")
  mealPlans            MealPlanEntry[]        @relation("TeamMealPlans")
  pantryItems          PantryItem[]           @relation("TeamPantryItems")
  storageItems         StorageItem[]          @relation("TeamStorageItems")
  storageSuppliers     StorageSupplier[]      @relation("TeamStorageSuppliers")
  storageDocuments     StorageDocument[]      @relation("TeamStorageDocuments")
  storageOrders        StoragePurchaseOrder[] @relation("TeamStorageOrders")
  pets                 Pet[]                  @relation("TeamPets")
  petShares            PetShare[]             @relation("TeamPetShares")
  enclosures           PetEnclosure[]         @relation("TeamEnclosures")
  breedingPairs        PetBreedingPair[]      @relation("TeamPairs")
  petSales             PetSale[]              @relation("TeamPetSales")
  vehicles             Vehicle[]              @relation("TeamVehicles")
  walletElements       WalletElement[]        @relation("TeamWalletElements")
  budgets              Budget[]               @relation("TeamBudgets")
  financeGoals         FinanceGoal[]          @relation("TeamFinanceGoals")
  languageDecks        LanguageDeck[]         @relation("TeamLanguageDecks")
  healthEvents         HealthEvent[]          @relation("TeamHealthEvents")
  medicationSchedules  MedicationSchedule[]   @relation("TeamMedicationSchedules")
  habits               Habit[]                @relation("TeamHabits")
  serviceCategories    ServiceCategory[]      @relation("TeamServiceCategories")
  skins                Skin[]                 @relation("SkinTeam")
  workshops            Workshop[]             @relation("TeamWorkshops")
  workspace            Workspace?             @relation("TeamWorkspace")

  @@index([ownerId])
}

model TeamMember {
  teamId       String
  userId       String
  role         String   @default("MEMBER") // "MEMBER" | "ADMIN" | "OWNER"
  // Z-194 (T-12): granularne role rodzic/dziecko. JSON string[] dozwolonych modułów
  // do WSPÓŁDZIELONYCH zasobów zespołu, albo NULL = brak ograniczeń (pełny dostęp).
  // "[]" = brak dostępu do żadnego współdzielonego modułu. OWNER/ADMIN ignorują to pole.
  moduleAccess String?
  joinedAt     DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model TeamInvitation {
  id            String   @id @default(cuid())
  teamId        String
  invitedById   String
  invitedUserId String
  status        String   @default("PENDING") // "PENDING" | "ACCEPTED" | "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  invitedUser User @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Restrict)

  @@unique([teamId, invitedUserId])
}

// ─── Shopping ─────────────────────────────────────────────────────────────

model ShoppingList {
  id          String    @id @default(cuid())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ownerId     String?
  ownerTeamId String?
  archived    Boolean   @default(false)
  archivedAt  DateTime?

  owner     User?  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?  @relation("TeamLists", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  items     Item[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model Item {
  id        String   @id @default(cuid())
  name      String
  quantity  Float?
  unit      String?
  category  String   @default("Other")
  status    String   @default("NEEDED")
  notes     String?
  price     Float? // S6: cena jednostkowa (do sumy zakupów → Portfel)
  priority  Int      @default(0)
  // Z-221 (T-03): ręczna kolejność DnD per-kategoria. Default 0 = brak ręcznego ułożenia
  // (sort fallbackuje na priority/createdAt). Nadpisuje sort po trasie sklepu.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listId    String

  list         ShoppingList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  recipeOrigin ItemRecipeOrigin?

  // Z-031: pozycje ładowane/filtrowane po (listId, status) — np. NEEDED do widoku,
  // DONE do czyszczenia. Model nie miał żadnego indeksu (pełny skan przy każdej liście).
  @@index([listId, status])
}

// 034: podpowiedzi zakupowe są prywatne — właściciel to użytkownik (bez wariantu zespołowego,
// jak `Store`). ownerId=null = rekord systemowy sprzed migracji.
model ItemHistory {
  id        String   @id @default(cuid())
  name      String
  category  String
  unit      String?
  useCount  Int      @default(1)
  ownerId   String?
  updatedAt DateTime @updatedAt
  owner     User?    @relation("OwnedItemHistory", fields: [ownerId], references: [id], onDelete: SetNull)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([workspaceId])
}

// ─── Product Catalog ──────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("Other")
  defaultUnit String?
  useCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // userId=null AND teamId=null → global/seed product visible to everyone
  userId      String?
  teamId      String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[]
}

// ─── System Config ────────────────────────────────────────────────────────

model Config {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Truck routing (Trasy TIR) ────────────────────────────────────────────
// Field names match the OpenRouteService `profile_params.restrictions` keys
// so they can be passed straight through to the routing request.

model VehicleProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  weight    Float    @default(40) // tony (DMC)
  height    Float    @default(4.0) // metry
  length    Float    @default(16.5) // metry
  width     Float    @default(2.55) // metry
  axleload  Float    @default(11.5) // tony / oś
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Custom Units ─────────────────────────────────────────────────────────

model Unit {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  // userId=null AND teamId=null → global base unit
  userId    String?
  teamId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([name, userId, teamId])
}

// ─── Custom Categories ────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("📦")
  createdAt DateTime @default(now())
  // userId=null AND teamId=null → global base category
  userId    String?
  teamId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([name, userId, teamId])
}

// ─── Category Icon Variants ───────────────────────────────────────────────

model CategoryIconVariant {
  id           String   @id @default(cuid())
  categoryName String
  svgContent   String
  isActive     Boolean  @default(false)
  userId       String?
  teamId       String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation("TeamIconVariants", fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, teamId, categoryName])
}

// ─── Notes ────────────────────────────────────────────────────────────────

// 034: grupy notatek mają właściciela (użytkownik LUB zespół). ownerId=null i ownerTeamId=null
// oznacza rekord SYSTEMOWY — wspólny dla wszystkich kont, edytowalny tylko przez administratora.
// FK z SetNull: skasowanie konta nie kasuje grupy, tylko czyni ją systemową.
model NoteGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]
  owner       User?    @relation("OwnedNoteGroups", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerTeam   Team?    @relation("TeamNoteGroups", fields: [ownerTeamId], references: [id], onDelete: SetNull)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// 034: etykiety również mają właściciela. Unikalność nazwy jest teraz „w obrębie właściciela",
// bo globalna blokowałaby drugiemu użytkownikowi założenie etykiety o tej samej nazwie.
model Tag {
  id          String      @id @default(cuid())
  name        String
  color       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime    @default(now())
  notes       NoteTag[]
  recipes     RecipeTag[]
  owner       User?       @relation("OwnedTags", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerTeam   Team?       @relation("TeamTags", fields: [ownerTeamId], references: [id], onDelete: SetNull)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, name])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model Note {
  id          String           @id @default(cuid())
  title       String
  content     String           @default("")
  isMarkdown  Boolean          @default(false)
  pinned      Boolean          @default(false)
  groupId     String?
  ownerId     String?
  ownerTeamId String?
  group       NoteGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  owner       User?            @relation("OwnedNotes", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam   Team?            @relation("TeamNotes", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tags        NoteTag[]
  attachments NoteAttachment[]
  revisions   NoteRevision[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  /// 062 (zadanie 15): WERSJA REKORDU — koniec cichej utraty pracy (rozdz. 8.5).
  /// Zapis z warunkiem na wersji odrzuca nadpisanie oparte na nieaktualnym odczycie.
  /// Rośnie WYŁĄCZNIE przez `updateWithVersion`; pilnuje tego `check:versioning`.
  version Int @default(0)

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// N4: historia/wersjonowanie notatki — migawka treści sprzed zmiany.
model NoteRevision {
  id        String   @id @default(cuid())
  noteId    String
  title     String
  content   String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
}

// N3: załączniki notatki (obrazy/pliki). url = data-URL lub link.
model NoteAttachment {
  id        String   @id @default(cuid())
  noteId    String
  name      String
  url       String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────

model TaskProject {
  id           String   @id @default(cuid())
  name         String
  description  String?
  color        String   @default("#6b7280")
  emoji        String   @default("📋")
  isInbox      Boolean  @default(false)
  ownerId      String?
  ownerTeamId  String?
  // JSON ProjectStatusConfig ({ enabled, chain }); null = domyślne statusy systemowe.
  statusConfig String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner     User?               @relation("OwnedTaskProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?               @relation("TeamTaskProjects", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  tasks     Task[]
  members   TaskProjectMember[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model TaskProjectMember {
  projectId String
  userId    String
  role      String   @default("MEMBER") // MEMBER | ADMIN | OWNER
  createdAt DateTime @default(now())

  project TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User        @relation("TaskProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

// Grupa projektów: stała, nazwana kombinacja projektów użytkownika (np. „Dom + Auto"),
// oglądana razem na /tasks/multi?group=<id>. Projekt może należeć do wielu grup (wiele-do-wielu),
// więc listę trzymamy jako JSON string[] (jak statusConfig / UserMenuPref) — bez tabeli łączącej.
// Nazwa tabeli w DB to historycznie „TaskView" (@@map) — koncepcja przemianowana na grupy.
model ProjectGroup {
  id         String   @id @default(cuid())
  name       String
  emoji      String   @default("🗂")
  color      String? // opcjonalny kolor (hex / token) na kropkę-znacznik przy projekcie
  projectIds String   @default("[]") // JSON: string[] id projektów w grupie
  ownerId    String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  owner User @relation("OwnedProjectGroups", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([workspaceId])
  @@map("TaskView")
}

model TaskTagDef {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6b7280")

  tasks TaskTaskTag[]
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          String    @default("TODO") // TODO | IN_PROGRESS | DONE | CANCELLED | DEFERRED
  priority        String    @default("NONE") // NONE | LOW | MEDIUM | HIGH | URGENT
  dueDate         DateTime?
  startDate       DateTime?
  completedAt     DateTime?
  lastCompletedAt DateTime? // data ostatniego wykonania (cykliczne: przenoszona na kolejne wystąpienie)
  estimatedMins   Int?
  recurring       String? // JSON: RecurringRule
  category        String    @default("Other")
  order           Float     @default(0)
  projectId       String?
  parentTaskId    String?
  previousTaskId  String? // 022: domknięte wystąpienie cykliczne, które utworzyło to zadanie
  createdById     String?
  assigneeId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         TaskProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent          Task?         @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks        Task[]        @relation("TaskSubtasks")
  previous        Task?         @relation("TaskRecurrence", fields: [previousTaskId], references: [id], onDelete: SetNull)
  nextOccurrences Task[]        @relation("TaskRecurrence")
  createdBy       User?         @relation("TasksCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignee        User?         @relation("TasksAssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  tags            TaskTaskTag[]
  comments        TaskComment[]
  shares          TaskShare[]

  // Z-031: indeksy pod realne zapytania list zadań (model nie miał żadnych).
  // (projectId, parentTaskId) pokrywa główny widok listy (WHERE projectId=… AND
  // parentTaskId IS NULL) i — jako prefiks — filtr po samym projectId.

  /// 062 (zadanie 15): WERSJA REKORDU — koniec cichej utraty pracy (rozdz. 8.5).
  /// Zapis z warunkiem na wersji odrzuca nadpisanie oparte na nieaktualnym odczycie.
  /// Rośnie WYŁĄCZNIE przez `updateWithVersion`; pilnuje tego `check:versioning`.
  version Int @default(0)

  @@index([projectId, parentTaskId])
  @@index([parentTaskId])
  @@index([previousTaskId])
  @@index([createdById])
  @@index([assigneeId])
}

model TaskTaskTag {
  taskId String
  tagId  String

  task Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  TaskTagDef @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation("TaskComments", fields: [userId], references: [id], onDelete: SetNull)

  // Z-031: komentarze ładowane/kasowane po taskId; userId pod purge konta (RODO).
  @@index([taskId])
  @@index([userId])
}

model TaskShare {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  teamId    String?
  role      String   @default("VIEWER") // VIEWER | EDITOR
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation("TaskShares", fields: [userId], references: [id], onDelete: SetNull)
  team Team? @relation("TeamTaskShares", fields: [teamId], references: [id], onDelete: SetNull)

  // Z-031: udostępnienia ładowane po taskId; userId pod listę „udostępnione mi" + purge.
  @@index([taskId])
  @@index([userId])
}

// ─── Activity Tracking ────────────────────────────────────────────────────

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String // "shopping" | "tasks" | "notes"
  action    String // "add_item" | "create_task" | "create_note" | etc.
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Store Maps ───────────────────────────────────────────────────────────────

model Store {
  id        String      @id @default(cuid())
  name      String
  ownerId   String?
  nodes     StoreNode[]
  edges     StoreEdge[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([workspaceId])
}

model StoreNode {
  id        String      @id @default(cuid())
  storeId   String
  label     String
  type      String      @default("CATEGORY")
  category  String?
  x         Float
  y         Float
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  edgesFrom StoreEdge[] @relation("EdgeFrom")
  edgesTo   StoreEdge[] @relation("EdgeTo")
}

model StoreEdge {
  id      String    @id @default(cuid())
  storeId String
  fromId  String
  toId    String
  weight  Float     @default(1)
  store   Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  from    StoreNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to      StoreNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
}

// ─── Reports ──────────────────────────────────────────────────────────────

model Report {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String // markdown content (pusty gdy storage="drive" — treść żyje na Dysku)
  category    String   @default("general")
  storage     String   @default("db") // "db" | "drive" — gdzie trzymana jest treść
  driveFileId String? // id pliku .md na Dysku Google (gdy storage="drive")
  authorId    String?
  teamId      String?
  author      User?    @relation("AuthoredReports", fields: [authorId], references: [id], onDelete: SetNull)
  team        Team?    @relation("TeamReports", fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, createdAt])
  @@index([authorId])
  @@index([teamId])
}

// Z-131 (T-17): kolejka zadań w tle dla ciężkich operacji AI (OCR/analizy/generacje).
// Wieloworkerowa od startu (pobieranie przez SELECT ... FOR UPDATE SKIP LOCKED w kodzie).
// Statusy jako String+unia TS (nie enum): QUEUED|RUNNING|DONE|FAILED|CANCELLED.
// Brak FK do User (ownerId = snapshot; sprzątane w purgeUserData) — jak AuditLog/Contact.
model Job {
  id          String    @id @default(cuid())
  type        String // np. "kitchen.ocrImage"
  status      String    @default("QUEUED")
  payload     String    @default("{}") // JSON wejścia
  result      String? // JSON wyniku (gdy DONE)
  error       String? // komunikat (gdy FAILED)
  // 039: etap wieloetapowego zadania („Pobieram źródła (3/5)…"). Stan musi być w kolejce, a nie w
  // przeglądarce — inaczej odświeżenie strony gubi informację, na czym stoi trwający przebieg.
  progress    String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now()) // backoff / harmonogram
  lockedAt    DateTime? // znacznik przejęcia przez workera
  ownerId     String? // per-user (polling, sprzątanie, RODO)
  dedupeKey   String? // idempotencja enqueue
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([status, runAfter])
  @@index([ownerId, createdAt])
  @@index([dedupeKey])
  @@index([workspaceId])
}

// Log pojedynczego wywołania LLM — obserwowalność jednostkowa (koszt/tokeny/czas
// per model i typ operacji). Log systemowy: BEZ FK do User (snapshot userId jako
// zwykły String?), by przeżył usunięcie usera — wzorem AuditLog. Statusy/typy jako
// String (bez enumów Prisma). Rozbicie per model/operationType przez indeksy.
model AiCall {
  id               String   @id @default(cuid())
  userId           String? // aktor (snapshot, bez relacji/FK); null dla wywołań systemowych
  operationType    String // "dispatch" | "reasoning" | "vision" | "generation"
  providerKind     String // "openai_compat" | "anthropic"
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cacheReadTokens  Int      @default(0) // tokeny odczytane z cache promptu (Anthropic)
  cacheWriteTokens Int      @default(0) // tokeny zapisane do cache promptu (Anthropic)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0) // koszt SZACOWANY wg cennika (lib/llm/pricing.ts)
  latencyMs        Int      @default(0)
  ok               Boolean  @default(true)
  status           Int? // status HTTP dostawcy (np. 200 / 429 / 503); null gdy nieznany
  errorText        String? // treść błędu dostawcy (skrócona) dla wywołań nieudanych
  conversationId   String? // powiązanie z rozmową asystenta (diagnostyka krok po kroku)
  attempts         Int      @default(1) // liczba prób wysłania (retry na 429/5xx wliczone)
  effort           String? // 032: poziom wysiłku FAKTYCZNIE użyty (LlmEffort); null = nie wysłano
  source           String? // np. "home_agent" | "fast_path" | "dispatch_route" | ...
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([model])
  @@index([operationType])
  @@index([conversationId])
}

// Asystent AI ("magiczna ikona") — trwała pamięć rozmów per-user.
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("Nowa rozmowa")
  // Krótkie podsumowanie starszych tur — wysyłane do LLM zamiast pełnej historii
  // (higiena kontekstu w długich rozmowach).
  summary   String?
  // 032: niewysłany tekst z pola wiadomości tej rozmowy (brudnopis). Trzymany na koncie, więc
  // wraca też na innym urządzeniu. NULL/"" = brak brudnopisu.
  draft     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  user      User        @relation("AiConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant" (TS union — bez enuma, zgodnie z regułą SQLite)
  content        String // markdown (asystent) / tekst (użytkownik)
  // Sidecar do odtworzenia kart w UI bez ponownego uruchamiania agenta.
  kind           String         @default("text") // "text" | "plan" | "report" | "navigate" | "clarify" | "results"
  data           Json? // actions[] | szkic raportu | cel nawigacji | log rozumowania
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Kitchen / Recipes ────────────────────────────────────────────────────

model Recipe {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String?
  introMarkdown String?   @default("")
  notes         String?   @default("")
  servings      Int       @default(2)
  prepMinutes   Int?
  cookMinutes   Int?
  difficulty    String    @default("easy")
  cuisine       String?
  mealType      String?
  coverImageUrl String?
  ownerId       String?
  ownerTeamId   String?
  cookbookId    String?
  // K2: wartości odżywcze na 1 porcję (opcjonalne).
  kcal          Int?
  protein       Float?
  carbs         Float?
  fat           Float?
  cookCount     Int       @default(0)
  lastCookedAt  DateTime?
  rating        Float?
  sourceUrl     String?
  sourceType    String    @default("manual")
  isPublic      Boolean   @default(false)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner          User?              @relation("OwnedRecipes", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam      Team?              @relation("TeamRecipes", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  cookbook       Cookbook?          @relation(fields: [cookbookId], references: [id], onDelete: SetNull)
  ingredients    RecipeIngredient[]
  steps          RecipeStep[]
  images         RecipeImage[]
  tags           RecipeTag[]
  plannedMeals   MealPlanEntry[]
  ratings        RecipeRating[]
  itemsGenerated ItemRecipeOrigin[] @relation("ItemsFromRecipe")

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([cookbookId])
  @@index([mealType, difficulty])
  @@index([workspaceId])
}

model RecipeIngredient {
  id         String  @id @default(cuid())
  recipeId   String
  productId  String?
  name       String
  quantity   Float?
  unit       String?
  unitPrice  Float? // Z-252: cena za jednostkę składnika (do kosztu przepisu / porcji)
  groupName  String?
  order      Int     @default(0)
  note       String?
  isOptional Boolean @default(false)

  recipe  Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([productId])
}

model RecipeStep {
  id          String  @id @default(cuid())
  recipeId    String
  order       Int
  text        String
  imageUrl    String?
  durationMin Int?
  temperature String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, order])
}

model RecipeImage {
  id          String  @id @default(cuid())
  recipeId    String
  url         String
  caption     String?
  // Tekst odczytany ze zdjęcia przez LLM (OCR), jako Markdown. null = nie analizowano,
  // "" = przeanalizowano, brak tekstu na zdjęciu.
  ocrMarkdown String?
  order       Int     @default(0)
  isCover     Boolean @default(false)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeTag {
  recipeId String
  tagId    String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

model RecipeRating {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  value     Int
  comment   String?
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
}

model Cookbook {
  id          String   @id @default(cuid())
  name        String
  description String?
  emoji       String   @default("📚")
  color       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?    @relation("OwnedCookbooks", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?    @relation("TeamCookbooks", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  recipes   Recipe[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model MealPlanEntry {
  id          String    @id @default(cuid())
  date        DateTime
  slot        String
  recipeId    String?
  customTitle String?
  servings    Int       @default(2)
  notes       String?
  ownerId     String?
  ownerTeamId String?
  status      String    @default("PLANNED")
  cookedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipe    Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  owner     User?   @relation("OwnedMealPlans", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?   @relation("TeamMealPlans", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId, date])
  @@index([ownerTeamId, date])
  @@index([date])
  @@index([workspaceId])
}

model PantryItem {
  id          String    @id @default(cuid())
  productId   String?
  name        String
  quantity    Float?
  unit        String?
  location    String?
  addedAt     DateTime  @default(now())
  expiresAt   DateTime?
  openedAt    DateTime?
  ownerId     String?
  ownerTeamId String?
  minQuantity Float?
  autoShop    Boolean   @default(false)

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner     User?    @relation("OwnedPantryItems", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?    @relation("TeamPantryItems", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([productId])
  @@index([expiresAt])
  @@index([workspaceId])
}

// Moduł Magazynowanie — ogólny magazyn (dom/firma/gospodarstwo): garaż, strych,
// szafy, ale też magazyny firmowe/sklepowe/hurtownie. W odróżnieniu od kuchennej
// spiżarni nie jest food-centric (brak dat ważności/produktów), za to ma SKU,
// magazyn nadrzędny (warehouse) oraz dziennik ruchów (przyjęcie/wydanie/korekta).
model StorageItem {
  id            String    @id @default(cuid())
  name          String
  sku           String?
  barcode       String?
  category      String?
  warehouse     String?
  location      String?
  quantity      Float?
  unit          String?
  minQuantity   Float?
  unitPrice     Float?
  photoUrl      String?
  expiresAt     DateTime?
  warrantyUntil DateTime?
  supplierId    String?
  notes         String?
  ownerId       String?
  ownerTeamId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner     User?             @relation("OwnedStorageItems", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?             @relation("TeamStorageItems", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  supplier  StorageSupplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements StorageMovement[]
  batches   StorageBatch[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([warehouse])
  @@index([sku])
  @@index([barcode])
  @@index([supplierId])
  @@index([workspaceId])
}

model StorageMovement {
  id         String   @id @default(cuid())
  itemId     String
  delta      Float
  reason     String?
  note       String?
  batchId    String?
  documentId String?
  createdAt  DateTime @default(now())

  item StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

// Preferencja użytkownika: tryb prosty (dom) vs profesjonalny (firma/magazyn).
model StorageSettings {
  userId    String   @id
  mode      String   @default("home") // "home" | "pro"
  currency  String   @default("PLN")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Dostawca/kontrahent (tryb pro): faktury, zamówienia, preferowane źródło pozycji.
model StorageSupplier {
  id          String   @id @default(cuid())
  name        String
  contact     String?
  email       String?
  phone       String?
  notes       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?                  @relation("OwnedStorageSuppliers", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?                  @relation("TeamStorageSuppliers", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  items     StorageItem[]
  documents StorageDocument[]
  orders    StoragePurchaseOrder[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// Partia/seria (FEFO): podlot pozycji z własną ilością, numerem partii/serii i ważnością.
model StorageBatch {
  id         String    @id @default(cuid())
  itemId     String
  lotNo      String?
  serialNo   String?
  quantity   Float     @default(0)
  expiresAt  DateTime?
  receivedAt DateTime  @default(now())
  note       String?

  item StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([expiresAt])
}

// Dokument magazynowy: PZ (przyjęcie), WZ (wydanie), faktura. Może powstać ze skanu.
model StorageDocument {
  id          String   @id @default(cuid())
  type        String // "PZ" | "WZ" | "faktura"
  number      String?
  supplierId  String?
  date        DateTime @default(now())
  totalCost   Float?
  imageUrl    String?
  notes       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())

  owner     User?                 @relation("OwnedStorageDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?                 @relation("TeamStorageDocuments", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  supplier  StorageSupplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines     StorageDocumentLine[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([supplierId])
  @@index([workspaceId])
}

model StorageDocumentLine {
  id         String  @id @default(cuid())
  documentId String
  itemId     String?
  name       String
  quantity   Float   @default(0)
  unit       String?
  unitPrice  Float?
  lineTotal  Float?

  document StorageDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// Zamówienie do dostawcy (tryb pro). Treść może zredagować LLM (draftText).
model StoragePurchaseOrder {
  id          String   @id @default(cuid())
  supplierId  String?
  status      String   @default("draft") // "draft" | "sent" | "received"
  date        DateTime @default(now())
  draftText   String?
  notes       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?                      @relation("OwnedStorageOrders", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?                      @relation("TeamStorageOrders", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  supplier  StorageSupplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines     StoragePurchaseOrderLine[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([supplierId])
  @@index([workspaceId])
}

model StoragePurchaseOrderLine {
  id       String  @id @default(cuid())
  orderId  String
  itemId   String?
  name     String
  quantity Float   @default(0)
  unit     String?

  order StoragePurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ItemRecipeOrigin {
  itemId       String  @id
  recipeId     String
  servings     Int     @default(2)
  ingredientId String?

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  recipe Recipe @relation("ItemsFromRecipe", fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

// ─── QA module: hierarchical test scenarios ────────────────────────────────

model QaEpic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  module      String // "shopping" | "tasks" | "notes" | "kitchen" | "home" | "admin" | "settings" | "auth" | "teams" | "reports" | "qa"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userStories QaUserStory[]

  @@index([module, order])
}

model QaUserStory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  epicId      String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  epic      QaEpic           @relation(fields: [epicId], references: [id], onDelete: Cascade)
  scenarios QaTestScenario[]

  @@index([epicId, order])
}

model QaTestScenario {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  type      String   @default("positive") // "positive" | "negative" | "edge"
  priority  String   @default("P1") // "P0" | "P1" | "P2"
  content   String // markdown
  storyId   String
  authorId  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story  QaUserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author User?       @relation("QaAuthored", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([storyId, order])
  @@index([priority])
  @@index([type])
}

// ─── Pets / Zwierzęta ───────────────────────────────────────────────────────
// Status/kind/category/role are String (not enum) — projektowa konwencja.
// featureFlags/recurring/details/payload trzymają JSON jako String.

model Pet {
  id           String    @id @default(cuid())
  name         String
  species      String    @default("other") // dog|cat|snake|lizard|turtle|fish|bird|rodent|rabbit|other
  breed        String? // rasa / morph / odmiana
  sex          String? // male|female|unknown
  birthDate    DateTime?
  birthApprox  Boolean   @default(false)
  acquiredAt   DateTime?
  acquiredFrom String?
  microchipId  String?
  identifier   String? // obrączka / tag
  color        String?
  photoUrl     String?
  status       String    @default("ACTIVE") // ACTIVE|DECEASED|REHOMED|SOLD|ARCHIVED
  deceasedAt   DateTime?
  notes        String?
  presetKey    String    @default("companion")
  featureFlags String? // JSON: { MEASUREMENTS: true, ... } — nadpisania per zwierzę
  enclosureId  String?
  sireId       String? // ojciec (rodowód)
  damId        String? // matka (rodowód)
  genetics     String? // JSON: [{ gene, mode, zygosity }] — genotyp/morphy
  ownerId      String?
  ownerTeamId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner           User?             @relation("OwnedPets", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam       Team?             @relation("TeamPets", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  shares          PetShare[]
  enclosure       PetEnclosure?     @relation(fields: [enclosureId], references: [id], onDelete: SetNull)
  sire            Pet?              @relation("PetSire", fields: [sireId], references: [id], onDelete: SetNull)
  dam             Pet?              @relation("PetDam", fields: [damId], references: [id], onDelete: SetNull)
  offspringAsSire Pet[]             @relation("PetSire")
  offspringAsDam  Pet[]             @relation("PetDam")
  measurements    PetMeasurement[]
  healthRecords   PetHealthRecord[]
  vetVisits       PetVetVisit[]
  treatments      PetTreatment[]
  careTasks       PetCareTask[]
  careLogs        PetCareLog[]
  pairsAsMale     PetBreedingPair[] @relation("PairMale")
  pairsAsFemale   PetBreedingPair[] @relation("PairFemale")
  sales           PetSale[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([enclosureId])
  @@index([sireId])
  @@index([damId])
  @@index([workspaceId])
}

model PetShare {
  id        String   @id @default(cuid())
  petId     String
  userId    String?
  teamId    String?
  role      String   @default("VIEWER") // VIEWER|EDITOR
  createdAt DateTime @default(now())

  pet  Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User? @relation("PetShares", fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation("TeamPetShares", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([petId, userId])
  @@unique([petId, teamId])
  @@index([petId])
}

model PetMeasurement {
  id          String   @id @default(cuid())
  petId       String
  date        DateTime @default(now())
  weightGrams Float?
  lengthCm    Float?
  bodyScore   Int? // 1-9 BCS
  note        String?
  createdAt   DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, date])
}

model PetHealthRecord {
  id          String   @id @default(cuid())
  petId       String
  type        String   @default("NOTE") // CONDITION|ALLERGY|SYMPTOM|INJURY|NOTE|MILESTONE
  title       String
  description String?
  date        DateTime @default(now())
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, date])
}

model PetVetVisit {
  id            String    @id @default(cuid())
  petId         String
  date          DateTime
  vetName       String?
  clinic        String?
  reason        String?
  diagnosis     String?
  cost          Float?
  nextVisitAt   DateTime?
  attachmentUrl String?
  notes         String?
  createdAt     DateTime  @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, date])
  @@index([nextVisitAt])
}

model PetTreatment {
  id         String    @id @default(cuid())
  petId      String
  kind       String    @default("MEDICATION") // MEDICATION|VACCINE|DEWORMER|PARASITE|SUPPLEMENT
  name       String
  dosage     String?
  route      String? // oral|injection|topical|...
  batch      String? // numer serii (szczepionki)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  recurring  String? // JSON: RecurringRule
  lastDoneAt DateTime?
  nextDueAt  DateTime?
  active     Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pet  Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  logs PetCareLog[]

  @@index([petId])
  @@index([nextDueAt])
}

model PetCareTask {
  id         String    @id @default(cuid())
  petId      String
  category   String    @default("CUSTOM") // FEEDING|CLEANING|GROOMING|WALK|WATER_CHANGE|UVB_REPLACEMENT|WEIGHING|CUSTOM
  title      String
  details    String? // JSON: dane specyficzne (np. typ pokarmu, porcja)
  recurring  String? // JSON: RecurringRule
  lastDoneAt DateTime?
  nextDueAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pet  Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  logs PetCareLog[]

  @@index([petId])
  @@index([nextDueAt])
}

model PetCareLog {
  id          String   @id @default(cuid())
  petId       String
  treatmentId String?
  careTaskId  String?
  category    String   @default("CUSTOM") // odzwierciedla kategorię/kind źródła lub FEEDING/HEALTH/...
  occurredAt  DateTime @default(now())
  payload     String? // JSON: np. { outcome: "REFUSED", preyType: "mysz" } lub parametry wody
  note        String?
  createdAt   DateTime @default(now())

  pet       Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  treatment PetTreatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  careTask  PetCareTask?  @relation(fields: [careTaskId], references: [id], onDelete: SetNull)

  @@index([petId, occurredAt])
}

// ─── Pets · Faza 2: Husbandry (terrarium / akwarium) ────────────────────────

model PetEnclosure {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("TERRARIUM") // TERRARIUM|AQUARIUM|PALUDARIUM|CAGE|AVIARY|TANK|OTHER
  lengthCm     Float?
  widthCm      Float?
  heightCm     Float?
  volumeL      Float?
  location     String?
  equipment    String? // JSON: [{ name, kind, installedAt, replaceEveryDays }]
  targetRanges String? // JSON: { paramKey: { min, max } } — nadpisania zakresów
  notes        String?
  ownerId      String?
  ownerTeamId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner     User?                   @relation("OwnedEnclosures", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?                   @relation("TeamEnclosures", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  pets      Pet[]
  readings  PetEnvironmentReading[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model PetEnvironmentReading {
  id          String   @id @default(cuid())
  enclosureId String
  measuredAt  DateTime @default(now())
  // Terrarium
  tempWarmC   Float?
  tempCoolC   Float?
  humidityPct Float?
  uvbIndex    Float?
  // Aquarium
  waterTempC  Float?
  ph          Float?
  ammoniaPpm  Float?
  nitritePpm  Float?
  nitratePpm  Float?
  salinityPpt Float?
  gh          Float?
  kh          Float?
  note        String?
  createdAt   DateTime @default(now())

  enclosure PetEnclosure @relation(fields: [enclosureId], references: [id], onDelete: Cascade)

  @@index([enclosureId, measuredAt])
}

// ─── Pets · Faza 3: Hodowla, rodowody, genetyka, sprzedaż ───────────────────

model PetBreedingPair {
  id          String    @id @default(cuid())
  name        String
  species     String    @default("other")
  maleId      String?
  femaleId    String?
  status      String    @default("PLANNED") // PLANNED|PAIRED|COOLING|PRODUCTIVE|RETIRED
  startedAt   DateTime?
  notes       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  male      Pet?        @relation("PairMale", fields: [maleId], references: [id], onDelete: SetNull)
  female    Pet?        @relation("PairFemale", fields: [femaleId], references: [id], onDelete: SetNull)
  owner     User?       @relation("OwnedPairs", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?       @relation("TeamPairs", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  clutches  PetClutch[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([maleId])
  @@index([femaleId])
  @@index([workspaceId])
}

model PetClutch {
  id              String    @id @default(cuid())
  pairId          String
  laidAt          DateTime?
  eggCount        Int?
  fertileCount    Int?
  incubationTempC Float?
  humidityPct     Float?
  expectedHatchAt DateTime?
  hatchedAt       DateTime?
  hatchedCount    Int?
  status          String    @default("INCUBATING") // INCUBATING|HATCHED|FAILED
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pair PetBreedingPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@index([pairId])
  @@index([expectedHatchAt])
}

model PetSale {
  id           String   @id @default(cuid())
  petId        String
  buyerName    String?
  buyerContact String?
  price        Float?
  currency     String   @default("PLN")
  soldAt       DateTime @default(now())
  notes        String?
  ownerId      String?
  ownerTeamId  String?
  createdAt    DateTime @default(now())

  pet       Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner     User? @relation("OwnedPetSales", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team? @relation("TeamPetSales", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([petId])
  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// ─── Flota (pojazdy: serwisy, opony, tankowania) ──────────────────────────

model Vehicle {
  id            String    @id @default(cuid())
  name          String
  make          String? // marka
  model         String?
  year          Int?
  plate         String? // nr rejestracyjny
  vin           String?
  fuelType      String    @default("petrol") // petrol|diesel|lpg|electric|hybrid
  odometer      Int       @default(0) // bieżący przebieg [km]
  inspectionDue DateTime? // przegląd techniczny
  insuranceDue  DateTime? // OC/AC
  notes         String?
  ownerId       String?
  ownerTeamId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner       User?               @relation("OwnedVehicles", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam   Team?               @relation("TeamVehicles", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  fuelLogs    FuelLog[]
  services    ServiceRecord[]
  attachments VehicleAttachment[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// F3: załączniki pojazdu (faktury, dowód rejestracyjny, OC). url = data-URL lub link.
model VehicleAttachment {
  id        String   @id @default(cuid())
  vehicleId String
  name      String
  url       String
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model FuelLog {
  id        String   @id @default(cuid())
  vehicleId String
  date      DateTime @default(now())
  odometer  Int // przebieg przy tankowaniu [km]
  liters    Float
  totalCost Float?
  full      Boolean  @default(true) // pełny bak (do wyliczenia zużycia)
  note      String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}

model ServiceRecord {
  id        String   @id @default(cuid())
  vehicleId String
  date      DateTime @default(now())
  odometer  Int?
  type      String   @default("other") // oil|tires|repair|inspection|insurance|other
  cost      Float?
  note      String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}

// ─── Portfel (elementy majątku + historia zmian salda) ────────────────────

model WalletElement {
  id          String   @id @default(cuid())
  name        String
  kind        String   @default("account") // cash|account|savings|investment|property|receivable|debt
  currency    String   @default("PLN")
  balance     Float    @default(0) // bieżące saldo (zdenormalizowane)
  archived    Boolean  @default(false)
  note        String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?         @relation("OwnedWalletElements", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?         @relation("TeamWalletElements", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  entries   WalletEntry[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model WalletEntry {
  id           String   @id @default(cuid())
  elementId    String
  date         DateTime @default(now())
  balanceAfter Float // saldo po zmianie — szereg czasowy do wykresów
  delta        Float // zmiana (+/-)
  kind         String   @default("adjustment") // income|expense|adjustment
  category     String?
  note         String?
  sourceModule String? // W4: moduł źródłowy auto-wydatku (np. "flota")
  sourceId     String? // W4: id rekordu źródłowego (FuelLog/ServiceRecord) — idempotencja + usuwanie
  createdAt    DateTime @default(now())

  element WalletElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@index([elementId, date])
  @@index([sourceModule, sourceId])
}

// W4: ustawienia automatycznego księgowania wydatków do Portfela (per-user).
model FinanceSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  autoExpenseEnabled   Boolean  @default(false)
  autoExpenseElementId String? // docelowy element portfela dla auto-wydatków
  baseCurrency         String   @default("PLN") // W5: waluta sprawozdawcza (przeliczanie majątku)
  aiAccessEnabled      Boolean  @default(true) // Z-055: czy asystent AI może czytać dane finansowe (opt-out, domyślnie wł.)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation("UserFinanceSettings", fields: [userId], references: [id], onDelete: Cascade)
}

// H1: personalizacja pulpitu (kolejność i ukrywanie sekcji strony głównej, per-user).
// 031: ustawienia asystenta AI per UŻYTKOWNIK (widoczne na każdym urządzeniu):
// stałe preferencje, poziom pracy asystenta i wybór głosu lektora.
model AssistantPref {
  id           String   @id @default(cuid())
  userId       String   @unique
  instructions String   @default("") // stałe preferencje („custom instructions")
  level        String   @default("standard") // AssistantLevel: "standard" | "economy"
  voiceKind    String   @default("browser") // AssistantVoiceKind: "browser" | "server"
  voiceId      String? // id głosu serwerowego (gdy voiceKind = "server")
  // 041: auto-zatwierdzanie BEZPIECZNYCH akcji asystenta. Akcje niszczące pytają zawsze —
  // klasyfikacja idzie z `DESTRUCTIVE_ACTION_TYPES`, nie z osobnej listy.
  autoApprove  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation("UserAssistantPref", fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardPref {
  id        String   @id @default(cuid())
  userId    String   @unique
  order     String   @default("[]") // JSON string[] kluczy sekcji w kolejności
  hidden    String   @default("[]") // JSON string[] ukrytych kluczy sekcji
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserDashboardPref", fields: [userId], references: [id], onDelete: Cascade)
}

// 042: ulubiony widok = prywatna zakładka nawigacyjna użytkownika (adres w aplikacji wraz
// z filtrami w query). Świadomie BEZ `ownerTeamId` — to preferencja, nie zasób do dzielenia
// (wzorzec: UserMenuPref / DashboardPref). `icon` i `color` to zwykłe Stringi; zbiór
// dopuszczalnych kolorów zawęża unia TS w `lib/favorites/favoriteViews.ts` (C-12 — zero enumów).
model FavoriteView {
  id        String   @id @default(cuid())
  ownerId   String
  label     String
  path      String // ścieżka wewnętrzna z parametrami, np. "/tasks/abc?status=IN_PROGRESS"
  icon      String   @default("⭐")
  color     String? // token motywu, np. "var(--accent-blue)" — nigdy hex (C-30)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner User @relation("OwnedFavoriteViews", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, path]) // AC-9: ponowny zapis tego samego adresu nie tworzy duplikatu
  @@index([ownerId, order])
  @@index([workspaceId])
}

// A1: dziennik audytu zmian RBAC i konfiguracji (kto / co / kiedy). Bez FK do User —
// e-mail aktora to migawka (zostaje czytelny nawet po usunięciu konta).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  category   String // "rbac" | "config"
  action     String // np. "role_permission.toggle"
  target     String? // czego dotyczy (rola, slug, klucz, providerId)
  detail     String? // czytelny opis
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
}

// H5: kosz / soft-delete. Zamiast twardo usuwać, zapisujemy migawkę (JSON) encji,
// by można ją było przywrócić. Lista list nie filtruje deletedAt — wiersz jest realnie usuwany,
// a przywracanie odtwarza go z migawki (z oryginalnym id).
model TrashItem {
  id        String   @id @default(cuid())
  userId    String // kto usunął (zakres widoczności kosza)
  module    String // "notes" | "tasks" | …
  entityId  String // oryginalne id encji
  title     String // czytelna etykieta
  payload   String // migawka JSON
  deletedAt DateTime @default(now())

  user User @relation("UserTrashItems", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  userId    String
  currency  String // np. "EUR"
  rate      Float // 1 `currency` = rate × baseCurrency
  source    String   @default("manual") // manual | nbp
  updatedAt DateTime @updatedAt

  user User @relation("UserExchangeRates", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
}

// W1: budżet wydatków per kategoria (limit na okres) — kategoria pasuje do WalletEntry.category.
model Budget {
  id          String   @id @default(cuid())
  category    String // dopasowanie do WalletEntry.category (free-text, konwencja PL)
  limitAmount Float // limit wydatków w okresie
  period      String   @default("monthly") // monthly (na razie tylko miesięczny)
  currency    String   @default("PLN")
  note        String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User? @relation("OwnedBudgets", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team? @relation("TeamBudgets", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// W1: cel oszczędnościowy (target + bieżący postęp, opcjonalny termin).
model FinanceGoal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  currency      String    @default("PLN")
  deadline      DateTime?
  achievedAt    DateTime?
  note          String?
  ownerId       String?
  ownerTeamId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner     User? @relation("OwnedFinanceGoals", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team? @relation("TeamFinanceGoals", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// ─── LLM model management ───────────────────────────────────────────────────
// Dostawcy LLM (każdy z własnym tokenem) + przypisanie modelu do typu operacji.
// `kind` jako String (konwencja projektu): "openai_compat" | "anthropic".

model LlmProvider {
  id        String   @id @default(cuid())
  label     String // np. "Groq (domyślny)"
  kind      String   @default("openai_compat") // "openai_compat" | "anthropic"
  baseUrl   String // np. https://api.groq.com/openai/v1
  apiKey    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments LlmAssignment[]
}

// Przypisanie modelu do typu operacji (charakter zadania, nie moduł).
// operationType: "dispatch" | "reasoning" | "vision" | "generation"
model LlmAssignment {
  operationType String
  // 034: AssistantConfigLevel ("economy" | "standard" | "max") — String + union TS (C-12).
  // Admin definiuje KAŻDY poziom osobno; pole puste = dziedziczy z poziomu "standard".
  level         String   @default("standard")
  providerId    String
  model         String? // null = dziedzicz model z poziomu "standard"
  temperature   Float?
  maxTokens     Int?
  // 032: LlmEffort ("none" | "low" | "medium" | "high"); null = brak (nie wysyłamy parametru).
  // Tłumaczenie na parametr dostawcy: src/lib/llm/effort.ts.
  effort        String?
  updatedAt     DateTime @updatedAt

  provider LlmProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@id([operationType, level])
  @@index([providerId])
}

// 034: WŁASNY poziom pracy asystenta (per użytkownik). Świadomie BEZ `maxTokens` — limit odpowiedzi
// zostaje w rękach administratora. `providerId` bez relacji (snapshot jak `AiCall.userId`):
// skasowanie dostawcy nie wysadza ustawień użytkownika, resolver sprawdza istnienie i `enabled`.
model UserLlmPref {
  id            String   @id @default(cuid())
  userId        String
  operationType String
  providerId    String?
  model         String?
  effort        String? // LlmEffort
  temperature   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("UserLlmPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationType])
  @@index([userId])
}

// 034: cennik modeli — przeniesiony z kodu (lib/llm/pricing.ts) do panelu admina, żeby aktualizacja
// stawek nie wymagała wdrożenia. Dopasowanie po PREFIKSIE nazwy modelu (id bywają z sufiksami wersji).
model LlmModelPrice {
  id             String   @id @default(cuid())
  modelPrefix    String   @unique
  label          String?
  inputPer1M     Float
  outputPer1M    Float
  cacheReadMult  Float    @default(0.1)
  cacheWriteMult Float    @default(1.25)
  updatedAt      DateTime @updatedAt
}

// ─── Nauka języków ──────────────────────────────────────────────────────────

model LanguageDeck {
  id          String   @id @default(cuid())
  name        String
  description String?
  nativeLang  String // język znany, np. "pl"
  targetLang  String // język uczony, np. "en"
  sourceText  String? // tekst, z którego wygenerowano słówka
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?        @relation("OwnedLanguageDecks", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?        @relation("TeamLanguageDecks", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  cards     Vocabulary[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model Vocabulary {
  id             String    @id @default(cuid())
  deckId         String
  term           String // słówko w języku uczonym
  translation    String // tłumaczenie w języku znanym
  example        String?
  partOfSpeech   String?
  notes          String?
  // SRS (SuperMemo-2)
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  deck LanguageDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId, dueAt])
}

// ─── Zdrowie ──────────────────────────────────────────────────────────────

// Jeden model z dyskryminatorem `kind` (konwencja String, nie enum).
// kind: "VISIT" (wizyta u lekarza) | "TEST" (badanie)
// status: "PLANNED" | "DONE" | "CANCELLED"
model HealthEvent {
  id           String    @id @default(cuid())
  kind         String    @default("VISIT")
  title        String // specjalizacja/cel wizyty lub nazwa badania
  doctorName   String?
  specialty    String?
  facility     String? // placówka / laboratorium
  location     String?
  scheduledAt  DateTime
  status       String    @default("PLANNED")
  notes        String?
  result       String? // wynik badania / podsumowanie wizyty
  // Z2: wartość liczbowa wyniku badania + jednostka — do trendów w czasie.
  numericValue Float?
  unit         String?
  referral     String? // skierowanie
  reminderAt   DateTime?
  ownerId      String?
  ownerTeamId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner       User?              @relation("OwnedHealthEvents", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam   Team?              @relation("TeamHealthEvents", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  attachments HealthAttachment[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId, scheduledAt])
  @@index([ownerTeamId, scheduledAt])
  @@index([workspaceId])
}

// Z1: repozytorium wyników — załączniki do wizyty/badania (PDF, zdjęcia). url = data-URL/link.
model HealthAttachment {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  url       String
  createdAt DateTime @default(now())

  event HealthEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ── Leki i pielęgnacja (harmonogram podawania) ───────────────────────────────
// Generyczny harmonogram: leki ORAZ czynności pielęgnacyjne (zmiana opatrunku,
// obcinanie paznokci itd.) — rozróżnia je pole `kind`. Cykliczność trzymamy
// "płasko" (freqType + interval + daysOfWeek + timesOfDay/hourly) — prościej niż
// JSON RecurringRule i wystarcza do: codziennie / wybrane dni / co N dni / co N godzin.
// Wykonania (odhaczenia konkretnych dawek) trafiają do MedicationLog.
model MedicationSchedule {
  id           String    @id @default(cuid())
  kind         String    @default("MEDICATION") // MEDICATION | CARE
  name         String // "Ibuprom" / "Zmiana opatrunku"
  dosage       String? // "200 mg" / "1 tabletka" / "1 plaster"
  route        String? // oral | injection | topical (dla leków)
  reason       String? // wskazanie / po co
  instructions String? // "po posiłku", "lewa ręka"
  freqType     String    @default("DAILY") // DAILY (co N dni) | WEEKLY | HOURLY
  interval     Int       @default(1) // DAILY: co N dni; HOURLY: co N godzin
  daysOfWeek   String? // CSV "1,3,5" (0=nd..6=sb) dla WEEKLY
  timesOfDay   String? // JSON ["08:00","20:00"] dla DAILY/WEEKLY
  hourlyStart  String? // "08:00" — kotwica dla HOURLY
  hourlyEnd    String? // "22:00" — granica dzienna dla HOURLY
  startDate    DateTime  @default(now())
  endDate      DateTime? // okno kuracji (opcjonalne)
  active       Boolean   @default(true)
  notes        String?
  ownerId      String?
  ownerTeamId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  owner     User?           @relation("OwnedMedicationSchedules", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?           @relation("TeamMedicationSchedules", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  logs      MedicationLog[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

model MedicationLog {
  id         String   @id @default(cuid())
  scheduleId String
  date       String // "YYYY-MM-DD" (lokalny dzień, stabilny klucz)
  slot       String // "HH:MM" — który slot dnia
  outcome    String   @default("TAKEN") // TAKEN | SKIPPED
  takenAt    DateTime @default(now())
  note       String?

  schedule MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date, slot])
  @@index([scheduleId, date])
}

// ── Habits (Nawyki) ──────────────────────────────────────────────────────────
// Tracker nawyków: definicja + dziennik wykonań (HabitEntry, jeden wpis na dzień).
// Wzorzec ownerId/ownerTeamId taki sam jak HealthEvent — wsparcie kont i zespołów.
model Habit {
  id           String   @id @default(cuid())
  name         String
  description  String?
  icon         String   @default("✅") // emoji
  color        String   @default("var(--accent-orange)") // token CSS motywu
  // CSV dni tygodnia 0=niedz..6=sob, np. "1,2,3,4,5". null/"" = codziennie.
  daysOfWeek   String?
  // HA2: cel tygodniowy (np. 3×/tydzień, dowolne dni). null = tryb dni tygodnia (daysOfWeek).
  weeklyGoal   Int?
  // Godzina przypomnienia w formacie "HH:MM" (czas lokalny). null = bez przypomnienia.
  reminderTime String?
  archived     Boolean  @default(false)
  sortOrder    Int      @default(0)
  ownerId      String?
  ownerTeamId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner     User?        @relation("OwnedHabits", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?        @relation("TeamHabits", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  entries   HabitEntry[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId, archived])
  @@index([ownerTeamId, archived])
  @@index([workspaceId])
}

model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  // Dzień wykonania jako "YYYY-MM-DD" (lokalny) — bez strefy czasowej, stabilne dla heatmapy.
  date      String
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}

// ─── Usługi (Marketplace) ──────────────────────────────────────────────────
// Dwustronny rynek usług (klient ↔ wykonawca) — konkurencja dla Fixly/Booksy.
// Każdy użytkownik może być klientem (składa zlecenia) i/lub wykonawcą
// (zakłada profil + oferty). Status zleceń trzymany jako String + unia TS
// (zasada repo: bez enumów Prisma — kompatybilność z SQLite/Postgres).

// Słownik kategorii usług, trójpoziomowy (system/user/team) wzorem Category.
model ServiceCategory {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("🛠️") // emoji
  color     String   @default("var(--accent-blue)")
  sortOrder Int      @default(0)
  // null/null = systemowa (widoczna dla wszystkich); userId = prywatna; teamId = zespołowa.
  userId    String?
  teamId    String?
  createdAt DateTime @default(now())

  user     User?            @relation("OwnedServiceCategories", fields: [userId], references: [id], onDelete: Cascade)
  team     Team?            @relation("TeamServiceCategories", fields: [teamId], references: [id], onDelete: Cascade)
  listings ServiceListing[]

  @@index([userId])
  @@index([teamId])
}

// Profil wykonawcy — jeden na użytkownika (rola „zleceniobiorca").
model ServiceProvider {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  // M19: czytelny, stabilny slug do udostępniania profilu (/services/providers/<slug>).
  slug        String?  @unique
  // M19: krótkie hasło/tagline na profil publiczny (meta-opis + nagłówek).
  tagline     String?
  bio         String?
  // Obszar działania (miasto/region) — wyszukiwanie tekstowe na start.
  area        String?
  phone       String?
  // "1" widoczny w katalogu, "0" ukryty (np. wstrzymany).
  visible     Boolean  @default(true)
  // Średnia ocen (denormalizowana dla szybkiego listowania) + liczba ocen.
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  // M7: weryfikacja wykonawcy (badge zaufania). NIP podaje wykonawca, verified ustawia admin.
  nip         String?
  verified    Boolean  @default(false)
  // M5: lokalizacja (filtr „w promieniu X km" + dystans). Ustawiana przez przeglądarkę.
  lat         Float?
  lon         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                  @relation("UserServiceProvider", fields: [userId], references: [id], onDelete: Cascade)
  listings     ServiceListing[]
  requests     ServiceRequest[]      @relation("ProviderServiceRequests")
  quotes       ServiceQuote[]
  images       ServiceImage[]
  availability ServiceAvailability[]
  favorites    ServiceFavorite[]
  promoCodes   ServicePromoCode[]
  staff        ServiceStaff[]

  @@index([visible])
}

// M11: ulubieni/obserwowani wykonawcy (per użytkownik). userId jako pole skalarne.
model ServiceFavorite {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  createdAt  DateTime @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId])
}

// Pojedyncza oferta usługi wystawiona przez wykonawcę.
model ServiceListing {
  id             String   @id @default(cuid())
  providerId     String
  categoryId     String?
  title          String
  description    String?
  // Model ceny: "fixed" | "hourly" | "quote" (wycena indywidualna).
  priceModel     String   @default("quote")
  // Cena w groszach (gdy fixed/hourly); null dla "quote".
  priceAmount    Int?
  currency       String   @default("PLN")
  active         Boolean  @default(true)
  // M8/M2: czas trwania usługi (min) + czy klient może rezerwować sloty (Booksy).
  durationMin    Int?
  bookingEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider ServiceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requests ServiceRequest[] @relation("ListingServiceRequests")

  @@index([providerId, active])
  @@index([categoryId])
}

// Zlecenie/rezerwacja: klient → wykonawca. Cykl życia w polu status.
model ServiceRequest {
  id          String    @id @default(cuid())
  clientId    String
  providerId  String
  listingId   String?
  title       String
  description String?
  // Preferowany termin realizacji (opcjonalny na etapie zapytania).
  preferredAt DateTime?
  // Ustalony termin po akceptacji przez wykonawcę.
  scheduledAt DateTime?
  // "REQUESTED" | "ACCEPTED" | "DECLINED" | "SCHEDULED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  status      String    @default("REQUESTED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staffId String? // M14: przypisany pracownik (null = solo/cała firma)

  client   User             @relation("ClientServiceRequests", fields: [clientId], references: [id], onDelete: Cascade)
  provider ServiceProvider  @relation("ProviderServiceRequests", fields: [providerId], references: [id], onDelete: Cascade)
  listing  ServiceListing?  @relation("ListingServiceRequests", fields: [listingId], references: [id], onDelete: SetNull)
  staff    ServiceStaff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  review   ServiceReview?
  messages ServiceMessage[]
  quotes   ServiceQuote[]
  payment  ServicePayment?
  disputes ServiceDispute[]

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([staffId, status])
}

// M17: spory/moderacja. Strona zlecenia (klient/wykonawca) zgłasza problem, moderator (admin)
// rozstrzyga. status OPEN | RESOLVED | REJECTED.
model ServiceDispute {
  id          String    @id @default(cuid())
  requestId   String
  openedById  String // user, który zgłosił
  reason      String // krótki tytuł/kategoria
  description String?
  status      String    @default("OPEN")
  resolution  String? // notatka moderatora
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requestId])
}

// Płatność za zlecenie (M9): kwota, metoda, status. Spięcie z Portfelem opt-in
// (osobno strona wykonawcy=przychód i klienta=wydatek). Jedna płatność / zlecenie.
model ServicePayment {
  id        String    @id @default(cuid())
  requestId String    @unique
  amount    Int // grosze (brutto, przed rabatem)
  currency  String    @default("PLN")
  method    String    @default("cash") // cash|transfer|card|other
  status    String    @default("UNPAID") // UNPAID|PAID
  promoCode String? // M16: zastosowany kod rabatowy
  discount  Int       @default(0) // M16: rabat w groszach (kwota netto = amount - discount)
  invoiceNo String?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// Ocena wystawiana przez klienta po zakończeniu zlecenia (1 na zlecenie).
model ServiceReview {
  id        String   @id @default(cuid())
  requestId String   @unique
  authorId  String
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation("AuthoredServiceReviews", fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── Wiadomości (News) ────────────────────────────────────────────────────
// Personalizowane streszczenia wiadomości z monitorowaniem tematów. Pobieranie
// na żądanie (RSS + dociągnięcie artykułu), twardy limit świeżości 24h, baza
// wiedzy per (temat × źródło) z wersjonowaniem. Prywatne per użytkownik.

model NewsSource {
  id          String   @id @default(cuid())
  ownerId     String
  // Stabilny klucz źródła: "onet" | "okopress" | "niezalezna" | własny slug.
  key         String
  name        String
  rssUrl      String
  homepageUrl String
  // 040: krótki opis źródła własnymi słowami („pop-science", „nature", „lewica"). Zastąpił zamknięty
  // zbiór left|center|right — zestaw kanałów dawno wyszedł poza politykę. Pusty = bez opisu
  // (dozwolone); kolor w UI liczony jest z tej wartości (`lib/news/sourceColor.ts`).
  descriptor  String   @default("")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  owner    User                @relation("OwnedNewsSources", fields: [ownerId], references: [id], onDelete: Cascade)
  items    NewsItem[]
  articles NewsArticle[]
  timeline NewsTimelineEntry[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, key])
  @@index([ownerId])
  @@index([workspaceId])
}

model NewsTopic {
  id              String    @id @default(cuid())
  ownerId         String
  title           String
  // Filtr semantyczny w naturalnym języku (np. „perypetie Z. Ziobry w sprawie zarzutów").
  semanticFilter  String
  enabled         Boolean   @default(true)
  sortOrder       Int       @default(0)
  lastRefreshedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner    User                @relation("OwnedNewsTopics", fields: [ownerId], references: [id], onDelete: Cascade)
  items    NewsItem[]
  timeline NewsTimelineEntry[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([workspaceId])
}

// 039: wspólna pula materiału — każde źródło pobierane RAZ na przebieg, niezależnie od tematów.
// Przypisanie do tematów (`NewsItem`) jest osobnym etapem, a gorące tematy czytają pulę zamiast
// pobierać kanały jeszcze raz.
model NewsArticle {
  id          String   @id @default(cuid())
  ownerId     String
  sourceId    String
  url         String
  title       String
  // Skrót z kanału RSS — materiał wejściowy do klasyfikacji i streszczeń.
  description String   @default("")
  imageUrl    String?
  // Data publikacji wg kanału.
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  owner  User       @relation("OwnedNewsArticles", fields: [ownerId], references: [id], onDelete: Cascade)
  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  items  NewsItem[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, sourceId, url])
  @@index([ownerId, publishedAt])
  @@index([workspaceId])
}

// 039: linia czasu tematu — zastąpiła wersjonowaną wiedzę (`NewsKnowledge`, usuniętą w 0217).
// Zamiast narastającego opisu stanu wiedzy per źródło: lista suchych faktów z datą ZDARZENIA.
model NewsTimelineEntry {
  id             String   @id @default(cuid())
  topicId        String
  // Data ZDARZENIA z treści materiału, nie data pobrania.
  eventDate      DateTime
  // "exact" | "approx" | "published" — skąd wzięliśmy datę (String + union, C-12).
  dateConfidence String   @default("published")
  // Jedno zdanie suchego faktu.
  fact           String
  // Odcisk faktu — zapora przed zapisaniem tej samej informacji drugi raz innymi słowami.
  fingerprint    String
  sourceId       String?
  articleId      String?
  createdAt      DateTime @default(now())

  topic  NewsTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  source NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([topicId, fingerprint])
  @@index([topicId, eventDate])
}

// 039: gorący temat odrzucony przez użytkownika („Nie proponuj"). Kluczem jest odcisk tytułu
// (`lib/textKey.ts`), bo gorący temat nie ma własnego wiersza — powstaje na nowo przy każdym
// przebiegu i model nie powtórzy tytułu znak w znak.
model NewsHiddenTopic {
  id          String   @id @default(cuid())
  ownerId     String
  fingerprint String
  title       String
  createdAt   DateTime @default(now())

  owner User @relation("OwnedNewsHiddenTopics", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, fingerprint])
  @@index([workspaceId])
}

model NewsItem {
  id            String   @id @default(cuid())
  topicId       String
  sourceId      String
  url           String
  title         String
  // Bieżące streszczenie w wybranej długości.
  summary       String
  // "short" | "medium" | "long" — poziom szczegółowości streszczenia.
  summaryLength String   @default("medium")
  // Co nowego wnosi względem stanu wiedzy (uzasadnienie „nowości").
  noveltyNote   String?
  imageUrl      String?
  publishedAt   DateTime
  // "PENDING" | "ACKNOWLEDGED" | "DISMISSED".
  status        String   @default("PENDING")
  // 039: artykuł z puli, z którego powstała ta pozycja. Opcjonalny — pozycje sprzed puli nie mają
  // czego wskazywać.
  articleId     String?
  createdAt     DateTime @default(now())

  topic   NewsTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  source  NewsSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  article NewsArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([topicId, sourceId, url])
  @@index([topicId, status])
  @@index([articleId])
}

model NewsPref {
  ownerId              String    @id
  // Domyślna długość streszczeń: "short" | "medium" | "long".
  defaultSummaryLength String    @default("medium")
  // Ostatnio wybrane źródło w widoku (klucz NewsSource).
  activeSourceKey      String?
  // 039: moment ostatniego pobrania PULI — wspólny dla wszystkich tematów, bo pobranie przestało
  // być czynnością pojedynczego tematu. NULL = nigdy (pierwszy przebieg bierze okno 24 h).
  lastFetchedAt        DateTime?
  updatedAt            DateTime  @updatedAt

  owner User @relation("NewsPref", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([workspaceId])
}

// 039: przekrojowa wiedza o użytkowniku — fakty, z których korzysta każdy moduł generujący treść
// „pod niego" (dziś Pogoda). Odrzucony fakt zostaje ze statusem "rejected", żeby nie wrócił przy
// kolejnym wnioskowaniu.
model UserFact {
  id          String   @id @default(cuid())
  ownerId     String
  // "interests" | "activity" | "lifestyle" | "constraints" | "content" (String + union, C-12).
  category    String
  // Treść faktu jednym zdaniem, po polsku.
  text        String
  // "guess" | "likely" | "confirmed" — trafia do promptu jako słowo, nie liczba.
  confidence  String   @default("guess")
  // "inferred" | "confirmed" | "admin" — fakt administratora nie jest nadpisywany automatycznie.
  origin      String   @default("inferred")
  // "active" | "rejected" — odrzucony nie wraca.
  status      String   @default("active")
  // Skąd konkretnie wyciągnięty (np. „zapisane pomysły pogodowe") — dla wglądu, nie dla logiki.
  evidence    String?
  fingerprint String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  owner User @relation("OwnedUserFacts", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, fingerprint])
  @@index([ownerId, status])
  @@index([workspaceId])
}

// ─── Pogoda (Weather) ─────────────────────────────────────────────────────
// Dane pogodowe pobierane na żywo z Open-Meteo (bez klucza). W bazie trzymamy
// tylko lokalizacje i „obserwatory" (alerty) użytkownika. Prywatne per user.

model WeatherLocation {
  id        String   @id @default(cuid())
  ownerId   String
  label     String
  lat       Float
  lon       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  owner User @relation("OwnedWeatherLocations", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([workspaceId])
}

model WeatherWatcher {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  // "preset" (gotowy scenariusz aktywności) | "custom" (opis w naturalnym języku).
  kind      String   @default("preset")
  presetKey String?
  // Treść obserwatora dla kind=custom (np. „weekend dobry na rower w górach").
  query     String?
  // Horyzont czasowy: "today" | "tomorrow" | "weekend" | "week".
  horizon   String   @default("week")
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  owner User @relation("OwnedWeatherWatchers", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([workspaceId])
}

// 037: propozycja „co robić", z którą użytkownik COŚ ZROBIŁ — obejrzał szczegóły, zapisał ją albo
// zablokował („nie proponuj"). Sama wygenerowana lista NIE ląduje w bazie: powtórne wejście na
// /pogoda tego samego dnia obsługuje pamięć podręczna promptu w `chatComplete`, więc trzymamy tu
// wyłącznie decyzje użytkownika i wygenerowane szczegóły, które mają go przeżyć.
model WeatherIdea {
  id            String    @id @default(cuid())
  ownerId       String
  // Odcisk tytułu (małe litery, bez diakrytyków i interpunkcji) — klucz naturalny propozycji.
  // Po nim rozpoznajemy powtórkę („już rozważana") i egzekwujemy blokadę.
  fingerprint   String
  title         String
  summary       String    @default("")
  // "outdoor" | "trip" | "home" | "other" — String + union TS (C-12), nigdy enum Prisma.
  category      String    @default("other")
  // "considered" | "saved" | "blocked".
  state         String    @default("considered")
  // Kontekst powstania — pozwala filtrować bibliotekę po lokalizacji.
  locationLabel String    @default("")
  lat           Float     @default(0)
  lon           Float     @default(0)
  // Wygenerowany szczegółowy plan (markdown); null = propozycja tylko zapisana/zablokowana.
  detail        String?
  detailAt      DateTime?
  detailRuns    Int       @default(0)
  // Zużycie ostatniej generacji szczegółów (JSON) — licznik kosztu przy ZAPISANEJ treści musi
  // działać także wtedy, gdy nie ma już świeżego wyniku z modelu.
  detailUsage   String?
  // 038: warunki z CHWILI ZAPROPONOWANIA — opis może powstać wiele dni później (leniwe
  // generowanie), a bez nich opisywałby pogodę z dnia czytania zamiast z dnia, dla którego
  // pomysł powstał. Opcjonalne: pomysły sprzed tej zmiany nasion nie mają.
  seedDate      String?
  seedPart      String?
  seedWeather   String?
  viewCount     Int       @default(0)
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  owner User @relation("OwnedWeatherIdeas", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, fingerprint])
  @@index([ownerId, state])
  @@index([workspaceId])
}

// 038: przekrojowa PAMIĘĆ TREŚCI generowanych przez AI — jedno miejsce dla wszystkich modułów.
// Treść AI znikała po odświeżeniu strony i powstawała od nowa, choć użytkownik o to nie prosił.
// Jeden generyczny model zamiast kolumn w każdym module: logika nieaktualności jest wszędzie taka
// sama (co to jest / dla jakiego zakresu / w jakich warunkach powstało / kiedy).
model AiContent {
  id        String   @id @default(cuid())
  ownerId   String
  // "weather.ideas" | "weather.ideaDetail" | "storage.insights" | … — String + union TS (C-12).
  kind      String
  // Co identyfikuje TĘ treść w obrębie rodzaju (np. lokalizacja|dzień|pora).
  scopeKey  String
  // Odcisk warunków powstania; różnica względem bieżących = treść nieaktualna, nie nieważna.
  inputHash String
  // Treść w postaci JSON (kształt zależy od rodzaju).
  content   String
  // Zużycie modelu (JSON) — licznik kosztu działa też przy treści z pamięci.
  usage     String?
  refreshes Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner User @relation("OwnedAiContent", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, kind, scopeKey])
  @@index([ownerId, kind])
  @@index([workspaceId])
}

// 041: tryb odświeżania sekcji AI — per użytkownik i rodzaj sekcji.
//
// Osobna tabela, a nie kolumny w `AssistantPref`: sekcji jest dziś pięć i przybywa ich z każdym
// modułem korzystającym z modelu. Kolumna per sekcja oznaczałaby migrację przy każdym dołożeniu.
// Domyślne SYSTEMOWE nie mieszkają tutaj (patrz `Config.ai_section_default_modes`) — wiersz z
// pustym właścicielem nie byłby chroniony przez indeks unikalny, bo w PostgreSQL `NULL != NULL`.
model AiSectionPref {
  id          String   @id @default(cuid())
  ownerId     String
  // Te same wartości co `AiContentKind` w kodzie (weather.ideas, news.hotTopics, …).
  sectionKind String
  // "onDemand" | "onChange" | "always" — String + union TS (C-12).
  mode        String   @default("onDemand")
  updatedAt   DateTime @default(now()) @updatedAt

  owner User @relation("OwnedAiSectionPrefs", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@unique([ownerId, sectionKind])
  @@index([workspaceId])
}

// 041: trwała historia przebiegów odświeżania Wiadomości.
//
// Nie da się jej odczytać z `Job`: `cleanupOldJobs` kasuje zakończone zadania po 24 godzinach, a
// `Job.result` trzyma wyłącznie ostatni przebieg. `usage` zapisujemy SUROWE (handler nie ma sesji);
// bramka widoczności kosztu działa przy odczycie — ten sam podział co dla `Job.result` od 039.
model NewsRefreshRun {
  id            String   @id @default(cuid())
  ownerId       String
  startedAt     DateTime
  finishedAt    DateTime @default(now())
  // "done" | "failed" — String + union TS (C-12).
  status        String   @default("done")
  // Liczby z wyniku — pozwalają odróżnić przebiegi od siebie, a nie tylko po godzinie.
  sources       Int      @default(0)
  fetched       Int      @default(0)
  assigned      Int      @default(0)
  summarized    Int      @default(0)
  timelineAdded Int      @default(0)
  usage         String?
  error         String?

  owner User @relation("OwnedNewsRefreshRuns", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId, finishedAt])
  @@index([workspaceId])
}

// ─── Warsztaty (Workshop) ───────────────────────────────────────────────────
// Zarządzanie przydomowym warsztatem/pracownią DOWOLNEGO typu (stolarski,
// samochodowy, malarski, elektroniczny…). Tryb Dom (hobbysta) / Pro (firma,
// kolektyw, zespół) — per-user, jak StorageSettings.

model WarsztatSettings {
  userId    String   @id
  mode      String   @default("home") // "home" | "pro"
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Pojedynczy warsztat/pracownia. `type` = klucz profilu z katalogu podpowiedzi
// (src/lib/warsztat/catalog.ts), np. "stolarski" | "samochodowy" | "malarski".
model Workshop {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("ogolny")
  description String?
  location    String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  owner     User?             @relation("OwnedWorkshops", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTeam Team?             @relation("TeamWorkshops", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  items     WorkshopItem[]
  projects  WorkshopProject[]

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// Wyposażenie warsztatu: narzędzia, maszyny, materiały eksploatacyjne, BHP.
// Dostęp dziedziczony z Workshop (brak własnego ownera). `kind`/`condition`/
// `status` to String (SQLite = brak enumów).
model WorkshopItem {
  id            String    @id @default(cuid())
  workshopId    String
  name          String
  kind          String    @default("tool") // "tool" | "machine" | "consumable" | "safety" | "material"
  category      String?
  quantity      Float?
  unit          String?
  minQuantity   Float? // próg low-stock (głównie materiały eksploatacyjne)
  condition     String    @default("good") // "new" | "good" | "worn" | "broken"
  status        String    @default("owned") // "owned" | "wishlist"
  brand         String?
  station       String? // stanowisko / miejsce w warsztacie
  assignedTo    String? // Pro: kto aktualnie ma narzędzie / komu wypożyczone
  purchasePrice Float?
  purchaseDate  DateTime?
  lastServiceAt DateTime?
  nextServiceAt DateTime? // termin następnego przeglądu/serwisu
  suggestionKey String? // powiązanie z pozycją katalogu podpowiedzi
  photoUrl      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([nextServiceAt])
}

// Pro: prosty dziennik projektów/zleceń realizowanych w warsztacie.
model WorkshopProject {
  id          String    @id @default(cuid())
  workshopId  String
  name        String
  description String?
  status      String    @default("planned") // "planned" | "active" | "done"
  assignedTo  String?
  startedAt   DateTime?
  dueAt       DateTime?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
}

// ─── Powiadomienia (NM3) ──────────────────────────────────────────────────
// Centralny silnik powiadomień zaprojektowany pod free tier (bez crona): skan
// nadchodzących terminów uruchamiany przy logowaniu / na żądanie (otwarcie
// dzwonka) generuje rekordy idempotentnie (dedupeKey). Web-push to przyszłe
// rozszerzenie — model jest fundamentem zarówno dla in-app, jak i push.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  module    String // tasks|health|flota|pets|languages|kitchen|services|system…
  title     String
  body      String?
  href      String?
  // Kiedy zdarzenie źródłowe jest należne (sortowanie + przyszłe push).
  dueAt     DateTime?
  readAt    DateTime?
  // Deterministyczny klucz źródła (np. "task-due-<id>"), by skan nie duplikował.
  dedupeKey String?
  createdAt DateTime  @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Marketplace: czat (M1) i wyceny (M3) ─────────────────────────────────
// Wątek wiadomości i historia wycen są zakotwiczone w zleceniu (ServiceRequest)
// — to wspólny kontener obu torów (Fixly/Booksy). Statusy jako String + unia TS.
model ServiceMessage {
  id        String    @id @default(cuid())
  requestId String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation("SentServiceMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model ServiceQuote {
  id         String    @id @default(cuid())
  requestId  String
  providerId String
  amount     Int // grosze
  currency   String    @default("PLN")
  message    String?
  status     String    @default("SENT") // SENT | ACCEPTED | REJECTED
  validUntil DateTime?
  createdAt  DateTime  @default(now())

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// Dostępność wykonawcy (M2): reguły tygodniowe. weekday 0=niedz…6=sob; minuty od północy.
model ServiceAvailability {
  id         String  @id @default(cuid())
  providerId String
  staffId    String? // M14: harmonogram konkretnego pracownika (null = solo/cała firma)
  weekday    Int // 0..6
  startMin   Int // np. 540 = 09:00
  endMin     Int // np. 1020 = 17:00

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  staff    ServiceStaff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([providerId, weekday])
  @@index([staffId, weekday])
}

// M14: pracownik/zasób firmy usługowej (salon/warsztat z wieloma osobami). Kazdy ma wlasny
// harmonogram dostepnosci i wlasne rezerwacje (ServiceRequest.staffId).
model ServiceStaff {
  id         String   @id @default(cuid())
  providerId String
  name       String
  role       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  provider     ServiceProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  availability ServiceAvailability[]
  requests     ServiceRequest[]

  @@index([providerId])
}

// Portfolio wykonawcy (M4): zdjęcia realizacji. url = data-URL lub link (wzorzec RecipeImage).
model ServiceImage {
  id         String   @id @default(cuid())
  providerId String
  url        String
  caption    String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, order])
}

// M16: kody rabatowe wykonawcy. kind percent (value=1..100) | amount (value=grosze).
model ServicePromoCode {
  id         String    @id @default(cuid())
  providerId String
  code       String // unikalny per wykonawca (zapisywany wielkimi literami)
  kind       String    @default("percent") // percent | amount
  value      Int // procent (1-100) lub grosze
  minAmount  Int? // minimalna kwota brutto (grosze), by kod zadziałał
  maxUses    Int? // limit użyć (null = bez limitu)
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, code])
  @@index([providerId])
}

// ─── Kontakty / osobisty CRM (NM9) ─────────────────────────────────────────
// Lekki CRM: baza relacji (klienci/wykonawcy/znajomi). Własność 3-poziom
// (ownerId/ownerTeamId jako pola skalarne — dostęp przez ownedByWhere). tags = JSON string[].
model Contact {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  company     String?
  tags        String? // JSON: string[]
  notes       String?
  ownerId     String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String? // 054/etap 1 — patrz nagłówek pliku

  @@index([ownerId])
  @@index([ownerTeamId])
  @@index([workspaceId])
}

// ─── Faza 2 przebudowy, zadanie 9 — PRZESTRZENIE I NADANIA (rozdz. 8.3) ─────────────────
//
// Fundament współdzielenia: „udostępnianie jest zdolnością platformy, nie funkcją modułu".
// W tym przebiegu tabele powstają i zostają WYPEŁNIONE (migracja 0226), ale NIC ich jeszcze nie
// czyta — aplikacja liczy dostęp dalej przez `ownerId`/`ownerTeamId`. Przełączenie odczytów to
// zadania 10 i 11.

/// Przestrzeń, w której żyje zasób. Użytkownik należy do wielu.
model Workspace {
  id   String @id @default(cuid())
  kind String // "personal" | "team" — String + unia TS (C-12)
  name String

  // Połączenie ze ŹRÓDŁEM lustra. Nie ma tego w szkicu rozdz. 8.3, a jest konieczne: bez niego
  // backfill nie da się powtórzyć idempotentnie, a zmiana składu zespołu nie ma jak odnaleźć jego
  // przestrzeni. Oba nullowalne i UNIKALNE — w PostgreSQL wartości NULL są w indeksie unikalnym
  // traktowane jako różne, więc jeden indeks daje niezmiennik „dokładnie jedna przestrzeń osobista
  // na użytkownika" i nie przeszkadza przestrzeniom zespołowym.
  personalUserId String? @unique
  teamId         String? @unique

  createdAt DateTime @default(now())

  personalUser User?             @relation("PersonalWorkspace", fields: [personalUserId], references: [id], onDelete: Cascade)
  team         Team?             @relation("TeamWorkspace", fields: [teamId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  grants       ResourceGrant[]

  @@index([kind])
}

/// Członkostwo w przestrzeni. Właściciel przestrzeni ma zawsze pełne prawa do tego, co w niej żyje.
model WorkspaceMember {
  workspaceId String
  userId      String
  role        String   @default("member") // "owner" | "admin" | "member" | "guest"
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

/// JEDNO nadanie dostępu do JEDNEGO zasobu. Docelowo zastępuje TaskShare, PetShare i
/// TaskProjectMember (zadanie 12) — dziś tabela istnieje i nie ma konsumenta.
///
/// ZNANE OGRANICZENIE, odroczone świadomie: `@@unique` nie zabezpiecza nadań linkowych
/// (`subjectType: "link"`, `subjectId: NULL`), bo w PostgreSQL NULL != NULL. Poprawka to częściowy
/// indeks w surowym SQL-u + wpis w `schema-drift-allowed.json`; robimy ją, gdy nadania linkowe
/// dostaną konsumenta (zadanie 12), a nie „na zapas".
model ResourceGrant {
  id           String    @id @default(cuid())
  workspaceId  String
  resourceType String // "tasks.project" | "notes.note" | … — TEKST, nie odwołanie do modułu (C-36)
  resourceId   String
  subjectType  String // "user" | "workspace" | "link"
  subjectId    String? // userId | workspaceId | NULL dla linku
  role         String // "viewer" | "commenter" | "editor" | "manager"
  inherited    Boolean   @default(false) // nadanie wyliczone z rodzica (projekt → zadanie)
  expiresAt    DateTime?
  createdById  String // bez klucza obcego — nadanie przeżywa usunięcie konta, które je wystawiło
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, subjectType, subjectId])
  @@index([subjectType, subjectId]) // „co mi udostępniono"
  @@index([resourceType, resourceId]) // „komu udostępniłem to"
  @@index([workspaceId])
}

/// Zaproszenie osoby, która jeszcze nie ma konta albo nie jest w przestrzeni.
/// Jak wyżej: tabela bez konsumenta do zadania 10.
model ResourceInvitation {
  id           String    @id @default(cuid())
  resourceType String
  resourceId   String
  email        String
  role         String
  token        String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  @@index([email])
}

/// 070 (zadanie 21, rozdz. 9.4) — DZIENNIK ZDARZEŃ DOMENOWYCH (outbox).
///
/// Zapisywany **w tej samej transakcji co mutacja** — to warunek poprawności całego mechanizmu,
/// nie zalecenie. Zapis poza transakcją to wg rozdz. 9.4.2 „najczęstszy błąd przy wdrażaniu
/// outboxu": przy awarii między zapisem stanu a zapisem zdarzenia jedno i drugie się rozjeżdża
/// i **nikt się o tym nie dowie** — nie ma błędu, nie ma logu, jest tylko reakcja, która nigdy
/// nie nastąpiła.
///
/// BEZ KLUCZY OBCYCH na `workspaceId` i `actorId` — celowo, tak jak `AuditLog`. Dziennik jest
/// zapisem historycznym: skasowanie przestrzeni albo konta nie może kaskadowo usunąć śladu, że
/// coś się wydarzyło. Konsekwencja: sprzątanie (zadanie 30) musi być jawne.
///
/// `id` służy zarazem za KLUCZ IDEMPOTENCJI dla zadania 22: publikacja daje gwarancję „co najmniej
/// raz" (rozdz. 9.4.4), więc subskrybent musi rozpoznać powtórkę — rozpozna ją po tym `id`, bo
/// powstaje przy zapisie, nie przy publikacji, i jest stabilne między ponowieniami.
model DomainEvent {
  id          String    @id @default(cuid())
  workspaceId String
  module      String
  /// String + unia TS (C-12) — NIGDY enum Prisma. Rejestr: src/platform/events/types.ts
  type        String
  payload     Json
  /// KTO wywołał. Przy zasobie współdzielonym to pytanie padnie (rozdz. 9.4.1).
  actorId     String?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([deliveredAt, createdAt]) // worker: „daj najstarsze niedostarczone" (zadanie 22)
  @@index([workspaceId, createdAt]) // strumień przestrzeni (zadanie 23)
}
